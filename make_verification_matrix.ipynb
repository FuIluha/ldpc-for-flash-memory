    "def gauss(matrix):\n",
    "    rows, cols = matrix.shape\n",
    "    operations = []  \n",
    "    for i in range(rows):        \n",
    "        if matrix[i, i] == 0:          \n",
    "            for j in range(i + 1, cols):\n",
    "                if matrix[i, j] != 0:\n",
    "                    matrix[:, [i, j]] = matrix[:, [j, i]]\n",
    "                    operations.append(Operation(i, j, 'swap_cols'))\n",
    "                    break\n",
    "        if matrix[i, i] == 0:\n",
    "            continue\n",
    "        for j in range(cols):\n",
    "            if j != i and matrix[i, j] == 1:\n",
    "                matrix[:, j] ^= matrix[:, i] \n",
    "                operations.append(Operation(i, j, 'xor'))\n",
    "    I = matrix[:rows, :rows]  \n",
    "    Q = matrix[:, rows:]\n",
    "    result = np.hstack((I, Q))\n",
    "    return result, operations\n"
   ]
