    "def revers_operation(matrix, operations):\n",
    "    matrix = matrix.astype(np.int32)\n",
    "    for operation in reversed(operations): \n",
    "        if operation.type == 'xor':  \n",
    "            i, j = operation.first, operation.second\n",
    "            matrix[i] = matrix[i] ^ matrix[j]\n",
    "        elif operation.type == 'swap_cols':  \n",
    "            i, j = operation.first, operation.second\n",
    "            matrix[:, [i, j]] = matrix[:, [j, i]]\n",
    "    return matrix\n",
    "correct_H = revers_operation(matrix, operations)\n",
    "correct_H = np.array(correct_H, dtype = int)   \n",
    "np.savetxt('verification_matrix.txt', correct_H, fmt=\"%d\", delimiter=',')\n",
    "correct_H\n",
    "\n",
    "correct_H.shape\n",
    "\n",
    "def dot_for_codes(a: np.array, b: np.array) -> np.array:\n",
    "    return np.array(a @ b % 2)\n",
    "\n",
    "dot_for_codes(correct_H, G.T)"
   ]
